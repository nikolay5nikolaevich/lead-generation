# Поиск компаний: https://app.tavily.com (бесплатно 1000 запросов в месяц)
TAVILY_API_KEY=
# Второй источник email, необязателен: https://hunter.io/api-keys
HUNTER_API_KEY=
# Трассировка прогонов в LangSmith, необязательна: https://smith.langchain.com → Settings → API Keys
# С ключом поставить LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leadgen
